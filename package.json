{
  "name": "meldivo",
  "version": "1.0.9",
  "description": "Always-on local voice hub for coding agents: talk hands-free to your Pi, OpenCode, and Claude Code sessions from any browser or phone. Private on-device speech (Parakeet + Kokoro). No cloud speech APIs.",
  "type": "module",
  "license": "MIT",
  "author": "Amir Rouhollahi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirrouh/meldivo.git"
  },
  "homepage": "https://github.com/amirrouh/meldivo#readme",
  "bugs": {
    "url": "https://github.com/amirrouh/meldivo/issues"
  },
  "keywords": [
    "coding-agent",
    "claude-code",
    "opencode",
    "pi-coding-agent",
    "voice-assistant",
    "voice-mode",
    "speech-to-text",
    "text-to-speech",
    "local-ai",
    "offline",
    "privacy",
    "hands-free",
    "ai-coding-assistant",
    "developer-tools",
    "parakeet",
    "kokoro",
    "sherpa-onnx",
    "voice-control",
    "llm",
    "cli"
  ],
  "bin": {
    "meldivo": "bin/meldivo.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node web/scripts/copy-vad-assets.mjs",
    "build": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json && cd web && vite build",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs",
    "prepublishOnly": "npm test",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/src/index.ts",
    "dev:web": "cd web && vite"
  },
  "dependencies": {
    "express": "^5.0.1",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@ricky0123/vad-web": "0.0.30",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
